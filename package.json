{
  "name": "rotem-office",
  "version": "1.3.2",
  "description": "Builds a court-ready PDF bundle: pleading + appendices, with dividers, table of contents and running page numbers.",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "split-reference": "node test/split-reference.js",
    "test": "npm run test:config && npm run test:verdicts && npm run test:build && npm run test:verify && npm run test:edge && npm run test:ui && npm run test:shell && npm run test:page-tools && npm run test:page-panels && npm run test:engine-tools && npm run test:recognition && npm run test:history && npm run test:history-ui && npm run test:updater-ui && npm run test:security && npm run test:selftest-failure && npm run test:selftest",
    "test:build": "electron test/build-headless.js",
    "test:verify": "node test/verify.js",
    "test:edge": "electron test/edge-cases.js",
    "test:ui": "electron test/ui-smoke.js",
    "test:security": "electron test/security.js",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "test:history": "electron test/history.js",
    "test:history-ui": "electron test/history-ui.js",
    "test:config": "node test/config.js",
    "test:selftest": "node scripts/run-selftest.js test/output/selftest.json -- electron .",
    "test:updater-ui": "electron test/updater-ui.js",
    "test:selftest-failure": "electron test/selftest-install-failure.js",
    "test:verdicts": "node test/selftest-verdicts.js",
    "test:shell": "electron test/shell.js",
    "test:page-tools": "electron test/page-tools.js",
    "test:page-panels": "electron test/page-panels.js",
    "test:engine-tools": "electron test/engine-tools.js",
    "test:recognition": "electron test/recognition.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@signpdf/placeholder-pdf-lib": "3.3.0",
    "@signpdf/signer-p12": "3.3.0",
    "@signpdf/signpdf": "3.3.0",
    "docx": "9.9.0",
    "electron-updater": "6.3.9",
    "exceljs": "4.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "pptxgenjs": "4.0.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "26.15.3"
  },
  "author": ""
}
